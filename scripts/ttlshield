#!/system/bin/sh
MODDIR="/data/adb/modules/gki_hotspot_shield"
[ -d "$MODDIR" ] || MODDIR="$(dirname "$0")/.."

if [ "$1" = "" ] || [ "$1" = "status" ] || [ "$1" = "-s" ]; then
    "$MODDIR/tether_shield" status
elif [ "$1" = "log" ] || [ "$1" = "-l" ]; then
    cat "$MODDIR/stats.json"
elif [ "$1" = "restart" ] || [ "$1" = "-r" ]; then
    killall -9 tether_shield 2>/dev/null
    nohup "$MODDIR/tether_shield" </dev/null >/dev/null 2>&1 &
    echo "GKI-Tether-Shield daemon restarted."
else
    "$MODDIR/tether_shield" "$@"
fi
