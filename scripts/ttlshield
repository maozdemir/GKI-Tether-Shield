#!/system/bin/sh
MODDIR="/data/adb/modules/gki_hotspot_shield"
[ -d "$MODDIR" ] || MODDIR="$(dirname "$0")/.."

case "$1" in
    ""|status|-s)
        # Live counters straight from the running daemon.
        "$MODDIR/tether_shield" status
        ;;
    log|-l)
        tail -n "${2:-50}" "$MODDIR/daemon.log" 2>/dev/null || echo "No log yet."
        if [ -s "$MODDIR/daemon.stderr" ]; then
            echo "--- last crash output (daemon.stderr) ---"
            tail -n 30 "$MODDIR/daemon.stderr"
        fi
        ;;
    restart|-r)
        killall tether_shield 2>/dev/null   # SIGTERM: queues unbind cleanly
        sleep 1
        nohup "$MODDIR/tether_shield" </dev/null >"$MODDIR/daemon.stderr" 2>&1 &
        echo "GKI-Tether-Shield daemon restarted."
        ;;
    *)
        "$MODDIR/tether_shield" "$@"
        ;;
esac
