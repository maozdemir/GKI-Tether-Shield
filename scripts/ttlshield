#!/system/bin/sh
MODDIR="/data/adb/modules/gki_hotspot_shield"
[ ! -f "$MODDIR/nfqttl" ] && MODDIR="/data/adb/modules/nfqttl"
[ ! -f "$MODDIR/nfqttl" ] && MODDIR="$(dirname "$0")/.."

if [ "$1" = "" ] || [ "$1" = "status" ] || [ "$1" = "-s" ]; then
    "$MODDIR/nfqttl" status
elif [ "$1" = "log" ] || [ "$1" = "-l" ]; then
    cat /data/local/tmp/ttlfixer_stats.json
elif [ "$1" = "restart" ] || [ "$1" = "-r" ]; then
    killall -9 nfqttl ttlfixer 2>/dev/null
    nohup "$MODDIR/nfqttl" </dev/null >/dev/null 2>&1 &
    echo "GKI-Tether-Shield daemon restarted."
else
    "$MODDIR/nfqttl" "$@"
fi
