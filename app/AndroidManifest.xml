<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode / versionName are injected from module.prop by scripts/build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alperozd.hotspotshield">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Hotspot Shield"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Not exported: only root (the module's action.sh, via am start -n)
             can start it and hand it the per-boot token; other apps cannot
             launch it with a token of their own choosing. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
